# =============================================================================
# CODE SLAYER — Root Environment Configuration Template
# Project by Team Tarnished | CodeX 3.0
# "Code together. Trust no one."
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 1. FRONTEND ENVIRONMENT (devception-client/.env.local)
# ─────────────────────────────────────────────────────────────────────────────

# Backend API & WebSocket URLs
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-hex-32

# Google OAuth (Optional for guest mode; required for Google sign-in)
# Obtain from Google Cloud Console → APIs & Services → Credentials:
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─────────────────────────────────────────────────────────────────────────────
# 2. BACKEND ENVIRONMENT (devception-server/.env)
# ─────────────────────────────────────────────────────────────────────────────

PORT=5000
NODE_ENV=development

# Database 1: PostgreSQL (Durable match persistence & audit logging)
# Supports local Postgres or hosted providers (Neon, Supabase, AWS RDS, Railway Postgres)
# Tables (users, rooms, matches, match_participants, match_votes, match_events)
# are automatically verified and created upon startup.
# Falls back to in-memory/MongoDB persistence gracefully if omitted or unreachable.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codeslayer

# Database 2: MongoDB (Active session state & player profiles)
# Local development default:
MONGODB_URI=mongodb://localhost:27017/codex

# Sandbox Code Execution: Judge0 API
# Supports Python, JavaScript, and C++.
# If credentials are not provided, automatically routes submissions through
# the built-in local development sandbox (Node.js vm, python3, g++) with full diagnostics.
#
# Option A: RapidAPI Judge0 CE
# JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_API_KEY=your-rapidapi-key
# JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
#
# Option B: Self-Hosted Docker Judge0
# JUDGE0_API_URL=http://localhost:2358
# JUDGE0_API_KEY=
# JUDGE0_API_HOST=
JUDGE0_API_URL=
JUDGE0_API_KEY=
JUDGE0_API_HOST=

# ── Astra AI Enhancements (Detective, Impostor Co-pilot, Developer Intelligence)
# Supports OpenAI (gpt-4o-mini / gpt-4o) or Google Gemini (gemini-1.5-flash / gemini-1.5-pro).
# If neither key is supplied, Astra runs high-fidelity deterministic fallback analysis
# based on AST inspection, diff analysis, and verified game telemetry (Zero-Key Resiliency).
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_MODEL=gpt-4o-mini

# Authentication Secret (Must match client NEXTAUTH_SECRET)
NEXTAUTH_SECRET=generate-with-openssl-rand-hex-32

# CORS Whitelist (Frontend Origin)
CLIENT_ORIGIN=http://localhost:3000

# Match Lifecycle & Timer Settings
GAME_DURATION_MS=900000        # 15 minutes match length
MEETING_DISCUSSION_MS=60000    # 60s emergency meeting discussion
MEETING_VOTING_MS=30000        # 30s emergency meeting voting
MIN_PLAYERS=4                  # Minimum players required to start match
MAX_PLAYERS=8                  # Maximum players per room

# Imposter Sabotage Cooldowns
IMPOSTER_BUG_COOLDOWN_MS=45000
IMPOSTER_BLUR_COOLDOWN_MS=60000
IMPOSTER_HINT_COOLDOWN_MS=30000

# Redis Adapter (Optional for single server; required for multi-pod clustering)
# REDIS_URL=redis://localhost:6379
