# ─────────────────────────────────────────────────────────────────────────────
# devception-server — Environment Variables Template
# Copy this file and fill in real values. Never commit the file with secrets.
#
# Platform notes:
#   Railway  → set via dashboard or railway.json (Railway auto-injects PORT)
#   Render   → set via dashboard (Render auto-injects PORT and RENDER=true)
#   Local    → copy to .env and fill in values
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# 1. PostgreSQL (Durable Match Persistence & Audit Logging)
#    - Automatically connects, verifies tables, and initializes schema if provided.
#    - If omitted or unreachable, automatically falls back to in-memory/MongoDB persistence with clean logging.
#    Example local:  postgresql://postgres:postgres@localhost:5432/codeslayer
#    Example cloud:  postgresql://user:password@ep-host.neon.tech/codeslayer?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codeslayer

# 2. MongoDB (Room Sessions & User Stats)
#    LOCAL DEVELOPMENT:
#      MONGODB_URI=mongodb://localhost:27017/codex
#    PRODUCTION (MongoDB Atlas):
#      MONGODB_URI=mongodb+srv://<db-user>:<db-password>@cluster0.mongodb.net/codex?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/codex

# ── Code Execution Sandbox (Judge0) ───────────────────────────────────────────
# If configured, code executions and test evaluations run against the Judge0 API.
# If omitted or left blank, the server automatically routes executions through
# the built-in local development sandbox (Node.js vm, python3, g++) with full diagnostics.
#
# Free/CE RapidAPI options:
#   JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
#   JUDGE0_API_KEY=<your-rapidapi-key>
#   JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
#
# Self-hosted / local docker:
#   JUDGE0_API_URL=http://localhost:2358
#   JUDGE0_API_KEY=
#   JUDGE0_API_HOST=
JUDGE0_API_URL=
JUDGE0_API_KEY=
JUDGE0_API_HOST=

# ── Redis / PubSub (Optional for single-instance, required for multi-pod) ──────
# REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
# Must match NEXTAUTH_SECRET in devception-client/.env.local (and Vercel dashboard)
# Generate a secure value:  openssl rand -hex 32
NEXTAUTH_SECRET=change-me-use-openssl-rand-hex-32

# ── CORS ──────────────────────────────────────────────────────────────────────
# The origin of the frontend. In production set to your Vercel deployment URL.
# Example: https://codeslayer.vercel.app
CLIENT_ORIGIN=http://localhost:3000

# ── Game settings ─────────────────────────────────────────────────────────────
GAME_DURATION_MS=900000
MEETING_DISCUSSION_MS=60000
MEETING_VOTING_MS=30000
MAX_PLAYERS=8
MIN_PLAYERS=4

# ── Imposter cooldowns ────────────────────────────────────────────────────────
IMPOSTER_BUG_COOLDOWN_MS=45000
IMPOSTER_BLUR_COOLDOWN_MS=60000
IMPOSTER_HINT_COOLDOWN_MS=30000

